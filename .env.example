# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=your_bot_username_without_at  # например: issue_helper_bot
ALLOWED_CHAT_IDS=-1001234567890  # через запятую, если групп несколько

# ── Основной LLM-провайдер (платный) ─────────────────────────────────────────
LLM_BASE_URL=https://your-provider.example.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=your-model-name

# ── Запасной провайдер (бесплатный OpenRouter) ────────────────────────────────
# Включается автоматически при ошибках основного (timeout, 402, 429, 5xx)
LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_API_KEY=sk-or-...
LLM_FALLBACK_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_DEFAULT_REPO=owner/repo  # например: myorg/myproject

# ── Storage ───────────────────────────────────────────────────────────────────
DATABASE_PATH=./data/bot.db
