# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=your_bot_username_without_at  # e.g. issue_helper_bot

# ── LLM (OpenAI-compatible) ───────────────────────────────────────────────────
# OpenRouter (default):
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...
LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free
# Если нужна поддержка изображений — используйте vision-совместимую модель:
# LLM_MODEL=google/gemini-flash-1.5
# LLM_MODEL=openai/gpt-4o-mini

# OpenAI напрямую (альтернатива):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Свой провайдер:
# LLM_BASE_URL=https://your-provider.example.com/v1
# LLM_API_KEY=...
# LLM_MODEL=your-model-name

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_DEFAULT_REPO=owner/repo  # e.g. myorg/myproject

# ── Storage ───────────────────────────────────────────────────────────────────
DATABASE_PATH=./data/bot.db
